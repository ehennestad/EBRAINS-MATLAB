  "target": [{ "path": "a.txt", "bytes": 2, "modified_time": "2024-01-01T00:00:00Z", "hash": "bbb" }],
  "expected": [{ "path": "a.txt", "action": "copy", "reason": "size", "bytes": 1 }]
}
